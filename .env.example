# SQLite database. Docker uses /data; local/devcontainer can override it.
DATABASE_PATH=/data/iptv-proxy.db

# Optional. If blank, the app securely generates a persistent secret at
# /data/.session-secret on first start. To supply your own:
#   openssl rand -hex 32
SESSION_SECRET=

# Public URL of the Next.js administration UI. The pathname is also used as
# the Next.js basePath at build time. Do not include a trailing slash.
UI_URL=http://localhost:3000/ui

# Secure cookies should stay true behind HTTPS. Set false only for direct HTTP testing.
COOKIE_SECURE=true

# Optional initial administrator seed. If INITIAL_ADMIN_PASSWORD is blank,
# the login screen enters first-run setup mode instead.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Ports whose reply traffic must bypass an active VPN tunnel so the admin UI
# and future Go proxy remain reachable from clients.
VPN_BYPASS_TCP_PORTS=3000,8080

# Maximum time to wait for a tunnel to become ready.
VPN_CONNECT_TIMEOUT_SECONDS=45

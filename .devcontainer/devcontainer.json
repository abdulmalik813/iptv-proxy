{
  "name": "IPTV Proxy Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerUser": "root",
  "remoteUser": "root",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--device=/dev/net/tun:/dev/net/tun",
    "--sysctl=net.ipv4.ip_forward=1",
    "--sysctl=net.ipv4.conf.all.src_valid_mark=1"
  ],
  "mounts": [
    "source=iptv-proxy-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=iptv-proxy-pnpm-store,target=/root/.local/share/pnpm/store,type=volume",
    "source=iptv-proxy-warp,target=/var/lib/cloudflare-warp,type=volume"
  ],
  "containerEnv": {
    "DATABASE_PATH": "${containerWorkspaceFolder}/data/iptv-proxy.db",
    "UI_URL": "http://localhost:3000/ui",
    "GO_PROXY_ADDR": ":8080",
    "COOKIE_SECURE": "false",
    "NEXT_TELEMETRY_DISABLED": "1",
    "VPN_BYPASS_TCP_PORTS": "3000,8080"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "golang.go"
      ]
    }
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Next.js Admin" },
    "8080": { "label": "Go Proxy" }
  },
  "postCreateCommand": "mkdir -p node_modules data /root/.local/share/pnpm/store /run/dbus /var/lib/cloudflare-warp && corepack enable && corepack prepare pnpm@11.24.0 --activate && pnpm install && go version",
  "postStartCommand": "mkdir -p /run/dbus /var/lib/cloudflare-warp && (pgrep -x dbus-daemon >/dev/null 2>&1 || dbus-daemon --system --fork || true)"
}
